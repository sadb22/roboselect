{
  "openapi": "3.0.3",
  "info": {
    "title": "Робоскоп API",
    "version": "1.0.0",
    "description": "Сессионная авторизация Django. Для POST/PUT/DELETE передавайте cookie csrftoken как заголовок X-CSRFToken. GET / устанавливает CSRF cookie. Все суммы в рублях. Неизвестные входные поля отклоняются. Экспорт сохранённой ревизии использует её снимок. При сохранении ранее загруженной версии calculation_revision указывает снимок для воспроизведения, а revision задаёт текущую ревизию проекта для защиты от конфликтов."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/bootstrap/": {
      "get": {
        "summary": "Начальные параметры, пользователь и три типа объектов",
        "responses": {
          "200": {
            "description": "Успешный результат"
          },
          "400": {
            "description": "Ошибка входов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Требуется вход"
          },
          "403": {
            "description": "Нет доступа или неверный CSRF"
          },
          "404": {
            "description": "Запись не найдена или принадлежит другому пользователю"
          },
          "409": {
            "description": "Конфликт ревизии или активный прогон"
          },
          "429": {
            "description": "Превышен лимит"
          }
        }
      }
    },
