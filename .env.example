# Copy to .env. Generate secrets with: python scripts/configure.py --domain your-domain.ru
SITE_DOMAIN=example.ru
ALLOWED_HOSTS=example.ru
CSRF_TRUSTED_ORIGINS=https://example.ru
SECRET_KEY=replace-with-random-secret
DB_PASSWORD=replace-with-random-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-unique-password
DEMO_USERNAME=reviewer
DEMO_PASSWORD=replace-with-unique-password

# Free demo access, including catalogue moderation
PASSWORDLESS_DEMO=1
